{
  "name": "crypto-lab-tc26-pair",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:typescript && node node_modules/@typescript/native/bin/tsc --noEmit && vite build",
    "check:typescript": "node --test tests/tooling.node.mjs",
    "fixtures:generate": "node scripts/generate-reference-fixtures.mjs",
    "wasm:build": "bash scripts/build-hypericum-wasm.sh && bash scripts/build-shipovnik-wasm.sh",
    "preview": "vite preview",
    "test": "vitest run && npm run check:typescript",
    "test:watch": "vitest",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@li0ard/streebog": "^0.2.6",
    "lucide": "^1.61.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
